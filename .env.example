# ========================================================
# TrailLens Environment Configuration
# ========================================================

APP_ENV=development
PORT=8000
HOST=0.0.0.0

# --------------------------------------------------------
# Open-Weight AI Configuration
# --------------------------------------------------------
# Options:
#   "demo"        : Zero-config deterministic offline engine (Recommended for initial tests & judge reviews)
#   "open_model"  : Live open-weight model via Ollama or Hugging Face Inference
AI_PROVIDER=demo

# Recommended open-weight architectures:
OPEN_MODEL_NAME=google/gemma-2-2b-it
VISION_MODEL_NAME=google/paligemma-3b-pt-224
OPEN_MODEL_LICENSE=Gemma Open Weights Terms of Use

# Local Ollama URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Hugging Face Inference API token (only needed if running cloud open weights)
HUGGINGFACE_API_KEY=

# --------------------------------------------------------
# MongoDB Atlas (Optional)
# If empty, TrailLens automatically falls back to local SQLite offline storage.
# --------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=traillens

# --------------------------------------------------------
# ElevenLabs Narration (Optional)
# If empty, TrailLens gracefully uses client-side browser Web Speech API.
# --------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --------------------------------------------------------
# Sentry Telemetry & Tracing (Optional)
# Strips all raw images, base64 payloads, and GPS coordinates automatically.
# --------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# --------------------------------------------------------
# File Upload Limits
# --------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
